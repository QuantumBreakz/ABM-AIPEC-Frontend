# ==============================================================================
# ABM-AIPEC Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local overrides:
#   cp .env.example .env.local
#
# On Vercel (Production):
#   Set these in Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API CONNECTION MODE
# ------------------------------------------------------------------------------
# Set to 'false' to connect to the live backend (Render or local backend on port 4000).
# Set to 'true' to run fully offline using the in-browser MSW mock dataset & seed data.
VITE_API_MOCK=false

# ------------------------------------------------------------------------------
# 2. BACKEND API BASE URL
# ------------------------------------------------------------------------------
# For local development with Vite dev proxy (routes /api/* to localhost:4000):
#   VITE_API_BASE=/api
#
# For production on Vercel:
#   - If using vercel.json rewrites: keep as /api
#   - If calling Render directly across origins:
#     VITE_API_BASE=https://<your-render-service-name>.onrender.com
VITE_API_BASE=/api
